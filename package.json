{
  "name": "tangluhu",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "wrangler dev --port 8787",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "build": "astro build",
    "preview": "npm run build && wrangler dev --port 8787",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute tanghulu-db --local --file=migrations/0001_init.sql && wrangler d1 execute tanghulu-db --local --file=migrations/0002_items.sql && wrangler d1 execute tanghulu-db --local --file=migrations/0003_seed.sql && wrangler d1 execute tanghulu-db --local --file=migrations/0004_featured.sql",
    "db:migrate:remote": "wrangler d1 execute tanghulu-db --remote --file=migrations/0004_featured.sql"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.4",
    "fuse.js": "^7.1.0",
    "hono": "^4.11.7",
    "marked": "^17.0.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251102.0",
    "wrangler": "^4.54.0"
  }
}
