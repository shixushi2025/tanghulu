---
import { imageMetadata } from '../lib/images';
interface Props { src?: string; title: string; category: string; eager?: boolean; detail?: boolean; }
const { src, title, category, eager = false, detail = false } = Astro.props;
const metadata = imageMetadata(src);
const kind = metadata?.kind ?? (category === 'film' ? 'poster' : category === 'book' ? 'book' : 'photo');
---
<div class:list={['cover-media', `cover-media--${kind}`, { 'cover-media--detail': detail, 'cover-media--product': category === 'car' || category === 'camera' }]} data-cover-media>
  <div class="cover-media__fallback"><slot /></div>
  {src && <div class="cover-media__image">
    <img src={src} alt={metadata?.alt ?? `${title}封面`} width={metadata?.width ?? 720} height={metadata?.height ?? 720}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={detail ? 'high' : 'auto'} decoding="async" referrerpolicy="no-referrer" />
  </div>}
</div>
<script>
  import { initializeCovers } from '../scripts/covers';
  initializeCovers();
</script>
<style is:global>
  .cover-media { position: relative; width: 100%; height: 100%; isolation: isolate; }
  .cover-media__fallback { position: relative; z-index: 0; width: 100%; height: 100%; }
  .cover-media__image { position: absolute; z-index: 1; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #f1eee8; }
  .cover-media__image img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform 250ms ease; }
  .cover-media--logo .cover-media__image { background: radial-gradient(ellipse at 50% 40%, #fff 0%, #fcfbf8 58%, #ede9e1 100%); }
  .cover-media--logo img { width: 48%; height: 48%; max-width: 180px; max-height: 140px; object-fit: contain; }
  .cover-media--logo.cover-media--detail img { width: 58%; height: 58%; max-width: 230px; max-height: 230px; }
  .cover-media--book .cover-media__image, .cover-media--poster .cover-media__image { padding: 0.9rem; background: radial-gradient(ellipse at 50% 30%, #fffdf7, #e8e1d5); }
  .cover-media--book img, .cover-media--poster img { width: auto; height: auto; max-width: 100%; max-height: 100%; filter: drop-shadow(3px 8px 8px #30251a30); }
  .cover-media--detail.cover-media--book .cover-media__image, .cover-media--detail.cover-media--poster .cover-media__image { padding: 1.25rem; }
  .cover-media--photo img { object-fit: cover; object-position: center 30%; }
  .cover-media--product img { object-fit: contain; }
  [data-image-error] .cover-media__image { display: none; }
  @media (prefers-reduced-motion: reduce) { .cover-media__image img { transition: none; } }
</style>
