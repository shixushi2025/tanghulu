---
import { browseUrl } from '../lib/browse';
interface Props { page: number; pages: number; total: number; path?: string; category?: string; sort?: string }
const { page, pages, total, path = '/', category = '', sort = 'newest' } = Astro.props;
---
<nav class="pagination" aria-label="内容分页">
  <span>共 {total} 颗 · 第 {page} / {pages} 页</span>
  <div>
    {page > 1 && <a class="button button--secondary" href={browseUrl(path, category, sort, page - 1)} rel="prev">← 上一页</a>}
    {page < pages && <a class="button button--primary" href={browseUrl(path, category, sort, page + 1)} rel="next">下一页 →</a>}
  </div>
</nav>
