---
import { itemCardHTML } from '../lib/item-card';

interface Props {
  title: string;
  category: string;
  tags?: string[];
  summary: string;
  cover?: string;
  slug: string;
  country?: string;
}

const { title, category, tags = [], summary, cover = '', slug, country = '' } = Astro.props;
const html = itemCardHTML({
  id: slug,
  title,
  category,
  tags,
  summary,
  cover,
  country,
});
---

<Fragment set:html={html} />
