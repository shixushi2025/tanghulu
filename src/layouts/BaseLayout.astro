---
import '../styles/global.css';
import { allCategories, visibleCategories, categoryConfig } from '../lib/categories';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '糖葫芦',
  description = '一份持续生长的私人精选：把真正值得看的、读的、用的，串在一起。',
} = Astro.props;

const currentPath = Astro.url.pathname;
const categoryMatch = currentPath.match(/^\/category\/([^/]+)/);
const activeCategory = categoryMatch ? categoryMatch[1] : null;
const isHome = currentPath === '/';
const pageTitle = title === '糖葫芦' ? '糖葫芦 · 把真正值得的，串在一起' : `${title} · 糖葫芦`;
const canonicalUrl = new URL(currentPath, Astro.url.origin);
const socialImageUrl = new URL('/og.png', Astro.url.origin);
const moreCategories = allCategories.filter((key) => !visibleCategories.includes(key as typeof visibleCategories[number]));
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f0e6" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="糖葫芦" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand" aria-label="糖葫芦首页">
          <img src="/logo.svg" alt="" width="34" height="42" />
          <span class="brand__name">糖葫芦</span>
          <span class="brand__note">私人精选</span>
        </a>

        <nav class="desktop-nav" aria-label="主导航">
          <a href="/" class:list={["nav-link", { "is-active": isHome }]} aria-current={isHome ? 'page' : undefined}>全部</a>
          {visibleCategories.map((key) => (
            <a
              href={`/category/${key}`}
              class:list={["nav-link", { "is-active": activeCategory === key }]}
              aria-current={activeCategory === key ? 'page' : undefined}
            >{categoryConfig[key].label}</a>
          ))}
          <details class="more-nav">
            <summary class:list={["nav-link", { "is-active": activeCategory && moreCategories.includes(activeCategory as typeof moreCategories[number]) }]}>更多</summary>
            <div class="more-nav__panel">
              {moreCategories.map((key) => (
                <a
                  href={`/category/${key}`}
                  class:list={["more-nav__link", { "is-active": activeCategory === key }]}
                  aria-current={activeCategory === key ? 'page' : undefined}
                >
                  <span class="category-dot" style={`--dot:${categoryConfig[key].accent}`}></span>
                  <span>{categoryConfig[key].label}</span>
                </a>
              ))}
            </div>
          </details>
          <a href="/about" class:list={["nav-link", { "is-active": currentPath === '/about' }]} aria-current={currentPath === '/about' ? 'page' : undefined}>关于</a>
        </nav>

        <div class="header-actions">
          <a href="/search" class:list={["search-link", { "is-active": currentPath === '/search' }]} aria-label="搜索糖葫芦">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>
            </svg>
            <span>找一颗</span>
          </a>
          <button id="menu-button" class="menu-button" type="button" aria-label="打开菜单" aria-controls="mobile-menu" aria-expanded="false">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <div id="mobile-menu" class="mobile-menu" hidden>
      <div class="mobile-menu__inner">
        <p class="mobile-menu__eyebrow">从哪一串开始？</p>
        <nav class="mobile-nav" aria-label="移动端导航">
          <a href="/" class:list={["mobile-nav__link", { "is-active": isHome }]} aria-current={isHome ? 'page' : undefined}>
            <span>全部精选</span><span aria-hidden="true">↗</span>
          </a>
          {allCategories.map((key) => (
            <a href={`/category/${key}`} class:list={["mobile-nav__link", { "is-active": activeCategory === key }]} aria-current={activeCategory === key ? 'page' : undefined}>
              <span><i class="category-dot" style={`--dot:${categoryConfig[key].accent}`}></i>{categoryConfig[key].label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href="/about" class:list={["mobile-nav__link", { "is-active": currentPath === '/about' }]} aria-current={currentPath === '/about' ? 'page' : undefined}>
            <span>关于这里</span><span aria-hidden="true">↗</span>
          </a>
        </nav>
        <p class="mobile-menu__foot">不追热点，不做排名。把适合谁、怎么开始说清楚。</p>
      </div>
    </div>

    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="footer-brand">
          <span class="footer-brand__name">糖葫芦</span>
          <p>把真正值得的，串在一起。</p>
        </div>
        <nav class="footer-nav" aria-label="页脚导航">
          <a href="/">全部精选</a>
          <a href="/search">搜索</a>
          <a href="/about">关于</a>
        </nav>
        <p class="footer-meta">© {currentYear} · 一份没有广告的私人清单</p>
      </div>
    </footer>

    <script>
      const button = document.getElementById('menu-button');
      const menu = document.getElementById('mobile-menu');

      function setMenu(open: boolean) {
        if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
        button.classList.toggle('is-open', open);
        menu.hidden = !open;
        document.body.classList.toggle('menu-open', open);
        document.getElementById('main-content')?.toggleAttribute('inert', open);
        document.querySelector('.site-footer')?.toggleAttribute('inert', open);
        if (open) menu.querySelector('a')?.focus();
      }

      button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          button.focus();
        }
      });

      window.matchMedia('(min-width: 1081px)').addEventListener('change', event => { if (event.matches) setMenu(false); });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Tab' || menu?.hidden || !menu) return;
        const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
        if (event.shiftKey && document.activeElement === button) { event.preventDefault(); links.at(-1)?.focus(); }
        else if (!event.shiftKey && document.activeElement === links.at(-1)) { event.preventDefault(); button?.focus(); }
      });
      document.querySelectorAll('.more-nav').forEach((details) => {
        details.addEventListener('toggle', () => {
          if (!(details instanceof HTMLDetailsElement) || !details.open) return;
          document.querySelectorAll('.more-nav[open]').forEach((other) => {
            if (other !== details) other.removeAttribute('open');
          });
        });
      });
    </script>
  </body>
</html>
