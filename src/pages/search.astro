---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索糖葫芦收录的电影、书籍、工具、健康与播客。">
  <div class="pt-2 pb-4">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-muted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="搜索电影、书籍、工具…"
        autofocus
        class="w-full pl-11 pr-4 py-3 rounded-xl border border-line bg-white text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand text-base"
      />
    </div>
  </div>

  <div id="results" class="mt-4"></div>
  <div id="empty" class="hidden text-center py-16 text-muted"><p>没有找到相关内容</p></div>
  <div id="hint" class="text-center py-16 text-muted text-sm"><p>输入关键词开始搜索</p></div>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';
  import { fetchItems } from '../lib/api';
  import { categoryConfig } from '../lib/categories';
  import { escapeHtml } from '../lib/item-card';

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('results');
  const emptyEl = document.getElementById('empty');
  const hintEl = document.getElementById('hint');

  const { items } = await fetchItems().catch(() => ({ items: [] }));
  const searchIndex = items.map((item) => ({
    id: item.id,
    title: item.title,
    summary: item.summary,
    category: item.category,
    categoryLabel: categoryConfig[item.category]?.label ?? '其他',
    tags: item.tags.join(' '),
    country: item.country ?? '',
  }));

  const fuse = new Fuse(searchIndex, {
    keys: [
      { name: 'title', weight: 0.5 },
      { name: 'summary', weight: 0.3 },
      { name: 'tags', weight: 0.15 },
      { name: 'country', weight: 0.05 },
    ],
    threshold: 0.4,
  });

  function renderResults(results: { item: (typeof searchIndex)[number] }[]) {
    if (!results.length) {
      if (resultsEl) resultsEl.innerHTML = '';
      emptyEl?.classList.remove('hidden');
      hintEl?.classList.add('hidden');
      return;
    }
    emptyEl?.classList.add('hidden');
    hintEl?.classList.add('hidden');
    if (!resultsEl) return;
    resultsEl.innerHTML = `
      <p class="text-sm text-muted mb-4">${results.length} 个结果</p>
      <div class="flex flex-col gap-2">
        ${results.map(({ item }) => {
          const cat = categoryConfig[item.category] ?? categoryConfig.other;
          return `<a href="/item/${escapeHtml(item.id)}" class="flex items-center gap-4 p-4 bg-white rounded-xl border border-line hover:border-brand/40 hover:shadow-sm transition-all group">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full ${cat.color} ${cat.bg}">${escapeHtml(item.categoryLabel)}</span>
                ${item.country ? `<span class="text-xs text-muted">${escapeHtml(item.country)}</span>` : ''}
              </div>
              <div class="font-medium text-ink group-hover:text-brand transition-colors truncate">${escapeHtml(item.title)}</div>
              <div class="text-sm text-muted mt-0.5 line-clamp-1">${escapeHtml(item.summary)}</div>
            </div>
          </a>`;
        }).join('')}
      </div>`;
  }

  input?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim();
    if (!q) {
      if (resultsEl) resultsEl.innerHTML = '';
      emptyEl?.classList.add('hidden');
      hintEl?.classList.remove('hidden');
      return;
    }
    renderResults(fuse.search(q));
  });

  const urlQ = new URLSearchParams(location.search).get('q');
  if (urlQ && input) {
    input.value = urlQ;
    renderResults(fuse.search(urlQ));
  }
</script>
