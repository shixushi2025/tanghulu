---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryConfig, visibleCategories } from '../lib/categories';
import { getAllItems } from '../lib/db';

const db = env.TANGHULU_DB;
const allItems = await getAllItems(db);
const searchIndex = allItems.map((item) => {
  const cat = categoryConfig[item.category] ?? categoryConfig.other;
  return {
    id: item.id,
    title: item.title,
    summary: item.summary,
    category: item.category,
    categoryLabel: cat.label,
    categoryShortLabel: cat.shortLabel,
    accent: cat.accent,
    tint: cat.tint,
    tags: item.tags,
    mood: item.mood,
    country: item.country ?? '',

  };
});
const safeSearchData = JSON.stringify(searchIndex)
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');

const popularQueries = ['AI 编程', '深夜', '睡眠', '通勤', '科幻', '写作'];
---

<BaseLayout title="搜索" description="按标题、标签或当下的心情，找到一颗值得的。">
  <section class="search-page" aria-labelledby="search-title">
    <header class="search-hero">
      <p class="eyebrow"><span></span>SEARCH THE STRING</p>
      <h1 id="search-title">找一颗<em>值得的。</em></h1>
      <p>搜标题、标签，或者你此刻的心情。</p>
    </header>

    <form id="search-form" class="search-form" role="search">
      <label class="sr-only" for="search-input">搜索糖葫芦的内容</label>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="试试「深夜」「通勤」或「AI 编程」"
        maxlength="100"
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-results"
      />
      <button id="search-clear" type="button" aria-label="清空搜索" hidden>清空</button>
      <span class="search-form__key" aria-hidden="true">ESC</span>
    </form>

    <div id="search-start" class="search-start">
      <div class="search-suggestions">
        <p>大家常找</p>
        <div>
          {popularQueries.map((query) => <button type="button" class="search-suggestion" data-query={query}>{query}</button>)}
        </div>
      </div>

      <div class="search-categories">
        <p>或者按分类开始</p>
        <div>
          {visibleCategories.map((key) => (
            <a href={`/category/${key}`} style={`--category-accent:${categoryConfig[key].accent};--category-tint:${categoryConfig[key].tint}`}>
              <span>{categoryConfig[key].shortLabel}</span>
              <strong>{categoryConfig[key].label}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </div>
    </div>

    <noscript><p>启用 JavaScript 可以即时搜索，也可以通过上面的分类继续浏览。</p></noscript>
    <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
    <div id="search-results" class="search-results" aria-label="搜索结果"></div>
    <div id="search-empty" class="search-empty" hidden>
      <div aria-hidden="true">?</div>
      <h2>这根签上还没有这一颗。</h2>
      <p>换个短一点的词，或者从上面的分类开始看看。</p>
    </div>
  </section>

  <script id="search-data" type="application/json" set:html={safeSearchData}></script>
  <script>
    import type { FuseResult } from 'fuse.js';
    import Fuse from 'fuse.js';

    interface SearchItem { id: string; title: string; summary: string; category: string; categoryLabel: string; categoryShortLabel: string; accent: string; tint: string; tags: string[]; mood: string[]; country: string }
    const dataElement = document.getElementById('search-data');
    const searchItems: SearchItem[] = JSON.parse(dataElement?.textContent || '[]');
    const form = document.getElementById('search-form');
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const clearButton = document.querySelector<HTMLButtonElement>('#search-clear');
    const start = document.getElementById('search-start');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');

    const fuse = new Fuse(searchItems, {
      keys: [
        { name: 'title', weight: 0.38 },
        { name: 'summary', weight: 0.22 },
        { name: 'tags', weight: 0.16 },
        { name: 'mood', weight: 0.14 },
        { name: 'categoryLabel', weight: 0.07 },
        { name: 'country', weight: 0.03 },
      ],
      threshold: 0.38,
      ignoreLocation: true,
      minMatchCharLength: 1,
    });

    function createElement<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) {
      const element = document.createElement(tag);
      if (className) element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    }

    function renderResults(matches: FuseResult<SearchItem>[], query: string) {
      results?.replaceChildren();
      if (!query) {
        start?.removeAttribute('hidden');
        empty?.setAttribute('hidden', '');
        if (status) status.textContent = '';
        return;
      }

      start?.setAttribute('hidden', '');
      if (!matches.length) {
        empty?.removeAttribute('hidden');
        if (status) status.textContent = `没有找到与“${query}”相关的内容`;
        return;
      }

      empty?.setAttribute('hidden', '');
      if (status) status.textContent = `找到 ${matches.length} 颗与“${query}”相关的内容`;
      const fragment = document.createDocumentFragment();

      matches.forEach(({ item }, index) => {
        const link = createElement('a', 'search-result');
        link.href = `/item/${encodeURIComponent(item.id)}`;
        link.style.setProperty('--result-accent', item.accent);
        link.style.setProperty('--result-tint', item.tint);
        link.dataset.resultIndex = String(index);

        const visual = createElement('div', 'search-result__visual');
        visual.setAttribute('aria-hidden', 'true');
        visual.append(createElement('span', '', item.categoryShortLabel));

        const body = createElement('div', 'search-result__body');
        const meta = createElement('div', 'search-result__meta');
        meta.append(createElement('span', '', item.categoryLabel));
        if (item.country) meta.append(createElement('i', '', item.country));
        body.append(meta, createElement('h2', '', item.title), createElement('p', '', item.summary));

        const contexts = [...(item.mood || []), ...(item.tags || [])].slice(0, 3);
        if (contexts.length) {
          const list = createElement('ul', 'search-result__contexts');
          contexts.forEach((context) => list.append(createElement('li', '', context)));
          body.append(list);
        }

        link.append(visual, body, createElement('span', 'search-result__arrow', '→'));
        fragment.append(link);
      });

      results?.append(fragment);
    }

    function runSearch(value: string, updateUrl = true) {
      const query = value.trim().slice(0, 100);
      if (clearButton) clearButton.hidden = !query;
      const matches = query ? fuse.search(query.replace(/\s+/g, ''), { limit: 40 }) : [];
      renderResults(matches, query);

      if (updateUrl) {
        const url = new URL(location.href);
        query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
        history.replaceState({}, '', url);
      }
    }

    let timer: ReturnType<typeof setTimeout>;
    form?.addEventListener('submit', event => { event.preventDefault(); clearTimeout(timer); runSearch(input?.value ?? ''); });
    input?.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(() => runSearch(input.value), 150); });
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        runSearch('');
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        document.querySelector<HTMLAnchorElement>('.search-result')?.focus();
      }
    });

    clearButton?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      input.focus();
      runSearch('');
    });

    document.querySelectorAll<HTMLButtonElement>('.search-suggestion').forEach((button) => {
      button.addEventListener('click', () => {
        if (!input) return;
        input.value = button.dataset.query || '';
        input.focus();
        runSearch(input.value);
      });
    });

    const initialQuery = new URLSearchParams(location.search).get('q') || '';
    if (input && initialQuery) input.value = initialQuery;
    runSearch(initialQuery, false);
  </script>
</BaseLayout>
