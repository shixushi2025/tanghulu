---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allCategories, categoryConfig } from '../lib/categories';
import CardTemplate from '../components/CardTemplate.astro';
import AsyncState from '../components/AsyncState.astro';
import { browseUrl } from '../lib/browse';
const moodEntrances = [
  { label: '通勤路上', query: '通勤', glyph: '听' },
  { label: '深夜独处', query: '深夜', glyph: '夜' },
  { label: '想学点东西', query: '学习', glyph: '学' },
  { label: '需要灵感', query: '灵感', glyph: '想' },
  { label: '开始行动', query: '行动', glyph: '做' },
  { label: '放松一下', query: '放松', glyph: '松' },
];
---

<BaseLayout>
  <AsyncState /><CardTemplate /><script>import "../scripts/browse-page";</script>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="eyebrow"><span></span>一份持续生长的私人精选</p>
      <h1 id="home-title">把真正值得的，<em>串在一起。</em></h1>
      <p class="home-hero__lead">不追热点，不做排名。把值得了解的内容、适合的场景和上手的方法，认真整理在一起。</p>
      <div class="home-hero__actions">
        <a class="button button--primary" href="/random">随便摘一颗 <span aria-hidden="true">↗</span></a>
        <a class="button button--secondary" href="#collection">从头逛逛 <span aria-hidden="true">↓</span></a>
      </div>
      <p class="home-hero__facts">
        <span>已串 <strong data-total>—</strong> 颗</span>
        <span>共 <strong data-category-count>—</strong> 类</span>
        <span><strong>0</strong> 广告</span>
      </p>
    </div>

    <div class="hero-object" aria-label="看、读、用，三种值得被串起来的体验">
      <div class="hero-object__stamp" aria-hidden="true">THL<br />SELECTS</div>
      <div class="hero-skewer" aria-hidden="true"></div>
      <div class="hero-fruit hero-fruit--one"><span>看</span><small>WATCH</small></div>
      <div class="hero-fruit hero-fruit--two"><span>读</span><small>READ</small></div>
      <div class="hero-fruit hero-fruit--three"><span>用</span><small>USE</small></div>
      <p class="hero-object__caption">每一颗都说清缘由，<br />把选择留给你。</p>
    </div>
  </section>

  <section class="mood-section" aria-labelledby="mood-title">
    <div class="section-heading section-heading--compact">
      <div>
        <p class="section-kicker">按此刻的心情</p>
        <h2 id="mood-title">现在的你，想来哪一颗？</h2>
      </div>
      <a href="/search" class="text-link">自己找找 <span aria-hidden="true">→</span></a>
    </div>
    <div class="mood-rail">
      {moodEntrances.map((mood) => (
        <a href={`/search?q=${encodeURIComponent(mood.query)}`} class="mood-chip">
          <span class="mood-chip__glyph" aria-hidden="true">{mood.glyph}</span>
          <span>{mood.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">主理人精选 · <span data-featured-count>—</span></p>
        <h2 id="featured-title">这次想递给你的几颗</h2>
      </div>
      <p>如果第一次来，从这里开始。</p>
    </div>
    <div class="featured-grid"></div>
  </section>

  <section class="editorial-section" aria-labelledby="editorial-title">
    <div class="section-heading"><div><p class="section-kicker">小小策展 · 从一个念头开始</p><h2 id="editorial-title">给日常，换一种打开方式。</h2></div><a class="text-link" href="/search">探索全部 →</a></div>
    <div class="editorial-grid">
      <a class="editorial-card editorial-card--ink" href="/search?q=AI"><span>01 / 工作与创造</span><h3>把琐碎交给工具，<br />把注意力留给创作。</h3><p>探索 AI 编程、写作与创意工具</p><b aria-hidden="true">↗</b></a>
      <a class="editorial-card editorial-card--green" href="/search?q=深夜"><span>02 / 留一点时间给自己</span><h3>夜深了，<br />故事才刚开始。</h3><p>一部电影，一段声音，一点回响</p><b aria-hidden="true">↗</b></a>
      <a class="editorial-card editorial-card--sand" href="/search?q=行动"><span>03 / 小步向前</span><h3>不必等准备好，<br />从一件小事开始。</h3><p>阅读、习惯与可实践的灵感</p><b aria-hidden="true">↗</b></a>
    </div>
  </section>

  <section id="collection" class="collection-section" aria-labelledby="collection-title">
    <div class="section-heading section-heading--collection">
      <div>
        <p class="section-kicker">完整收藏 · <span data-total>—</span></p>
        <h2 id="collection-title">整串慢慢逛</h2>
      </div>
      <p>电影、书、工具和声音，不必属于同一类，只要值得。</p>
    </div>

    <nav class="category-rail" aria-label="按分类浏览">
      <a class="category-filter is-active" aria-current="page" href="/#collection">全部 <span data-count="">—</span></a>
      {allCategories.map((key) => (
        <a class="category-filter" href={browseUrl("/", key, "newest", 1)} style={`--filter-accent:${categoryConfig[key].accent}`}>
          {categoryConfig[key].label} <span data-count={key}>—</span>
        </a>
      ))}
    </nav>

    <form class="collection-toolbar" action="/#collection" method="get">
      <p id="collection-count"></p>
      <div><label for="sort">排列方式</label><select id="sort" name="sort" disabled>
        <option value="newest" selected>最近收录</option>
        <option value="oldest">最早收录</option>
        <option value="title">按标题</option>
      </select><button class="text-link" type="submit" disabled>应用</button></div>
    </form>
    <div class="empty-state" id="collection-empty" hidden><h3>第一颗，留给下一次发现。</h3><p>内容收录后会出现在这里。</p></div>
    <div class="collection-grid"></div>
    <nav class="pagination" aria-label="内容分页"></nav>
  </section>

  <aside class="home-manifesto">
    <span class="home-manifesto__mark" aria-hidden="true">「</span>
    <p>没有广告，也没有“全网最好”。<br />让介绍有依据，让选择多一点方向。</p>
    <a href="/about">为什么做这个网站 <span aria-hidden="true">→</span></a>
  </aside>
</BaseLayout>
