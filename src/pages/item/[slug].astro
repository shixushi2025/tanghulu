---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemCard from '../../components/ItemCard.astro';
import CoverImage from '../../components/CoverImage.astro';
import { imageMetadata } from '../../lib/images';
import { categoryConfig } from '../../lib/categories';
import { getItemById, getRelatedItems } from '../../lib/db';
import { marked } from 'marked';
import xss, { getDefaultWhiteList } from 'xss';

const { slug } = Astro.params;
const db = env.TANGHULU_DB;
const item = slug ? await getItemById(db, slug) : null;

if (!item) Astro.response.status = 404;

const cat = item ? (categoryConfig[item.category] ?? categoryConfig.other) : categoryConfig.other;
const rawBody = item?.body ? await marked(item.body) : '';
let bodyHtml = xss(rawBody, {
  whiteList: {
    ...getDefaultWhiteList(),
    a: ['href', 'title', 'target', 'rel'],
    img: ['src', 'alt', 'title', 'width', 'height', 'loading'],
  },
  stripIgnoreTag: true,
  stripIgnoreTagBody: ['script', 'style', 'iframe', 'object'],
});

const headings: { id: string; title: string }[] = [];
bodyHtml = bodyHtml.replace(/<h2>([\s\S]*?)<\/h2>/g, (_, title: string) => {
  const id = `section-${headings.length + 1}`;
  headings.push({ id, title: title.replace(/<[^>]+>/g, '') });
  return `<h2 id="${id}">${title}</h2>`;
});
const readingMinutes = Math.max(1, Math.ceil((item?.body.length ?? 0) / 400));
const relatedItems = item ? await getRelatedItems(db, item.category, item.id) : [];

const coverMetadata = imageMetadata(item?.cover);
const externalLabel = item
  ? item.category === 'tool' ? `打开 ${item.title}`
    : item.category === 'film' ? '去豆瓣看看'
    : item.category === 'podcast' ? '去听听'
    : item.category === 'book' ? '查看这本书'
    : '打开原页面'
  : '';
---

{item ? (
  <BaseLayout title={item.title} description={item.summary}>
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">整串</a><span aria-hidden="true">/</span>
      <a href={`/category/${item.category}`}>{cat.label}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{item.title}</span>
    </nav>

    <article class="detail-hero" style={`--category-accent:${cat.accent};--category-tint:${cat.tint}`}>
      <figure class="detail-cover">
      <div class="detail-poster">
        <CoverImage src={item.cover} title={item.title} category={item.category} eager detail>
          <div class="detail-poster__art" aria-hidden="true">
            <span class="detail-poster__label">TANGHULU SELECTS</span>
            <span class="detail-poster__number">{cat.shortLabel}</span>
            <span class="detail-poster__skewer"></span>
            <span class="detail-poster__fruit detail-poster__fruit--one"></span>
            <span class="detail-poster__fruit detail-poster__fruit--two"></span>
            <span class="detail-poster__fruit detail-poster__fruit--three"></span>
            <span class="detail-poster__category">{cat.label}</span>
          </div>
        </CoverImage>
      </div>
      {coverMetadata && <figcaption class="image-credit">
        {coverMetadata.edition && <span>{coverMetadata.edition} · </span>}
        <a href={coverMetadata.sourcePage} target="_blank" rel="noopener noreferrer">图片来源 ↗</a>
        {coverMetadata.credit && <span> · {coverMetadata.credit} · <a href={coverMetadata.licenseUrl} target="_blank" rel="noopener noreferrer">{coverMetadata.license}</a> · {coverMetadata.transformation}</span>}
      </figcaption>}
      </figure>

      <div class="detail-hero__copy">
        <div class="detail-hero__meta">
          <a class="category-pill" href={`/category/${item.category}`} style={`--pill-accent:${cat.accent};--pill-tint:${cat.tint}`}>{cat.label}</a>
          {item.country && <span>{item.country}</span>}
          <time datetime={item.date}>{item.date}</time>
        </div>
        <p class="section-kicker">一颗认真整理的内容</p>
        <h1>{item.title}</h1>
        <p class="detail-hero__summary"><span>一句话</span>{item.summary}</p>

        {item.mood.length > 0 && (
          <div class="detail-contexts">
            <span>适合</span>
            <ul aria-label="适合场景">
              {item.mood.map((mood) => <li>{mood}</li>)}
            </ul>
          </div>
        )}

        <div class="detail-actions">
          {item.link && (
            <a href={item.link} target="_blank" rel="noopener noreferrer" class="button button--primary">
              {externalLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
          <button id="share-button" class="button button--secondary" type="button">分享这颗 <span aria-hidden="true">↗</span></button>
        </div>

        <div class="detail-stats" aria-label="社区数据">
          <div><strong id="community-avg">—</strong><span>社区评分 / 5</span></div>
          <div><strong id="community-count">—</strong><span>人留下评分</span></div>
          <div><strong id="view-count">—</strong><span>次被摘下</span></div>
        </div>
      </div>
    </article>

    <div class="detail-layout">
      <article class="detail-article prose"><p class="reading-meta">约 {readingMinutes} 分钟阅读 · 供你慢慢挑选</p><Fragment set:html={bodyHtml || '<p>这颗内容的详细介绍正在整理中。</p>'} /></article>

      <aside class="detail-sidebar">
        {headings.length > 0 && <nav class="reading-nav" aria-label="本文目录"><h2>这颗的味道</h2>{headings.map(heading => <a href={`#${heading.id}`}>{heading.title}</a>)}</nav>}
        <div class="rating-panel">
          <p class="section-kicker">轮到你了</p>
          <h2>你会给它几颗糖？</h2>
          <p>你的评分会和其他读者一起，留在这根签上。</p>
          <div class="sugar-rating" id="sugar-rating" role="group" aria-label="选择一到五星评分">
            {[1, 2, 3, 4, 5].map((score) => (
              <button class="rating-fruit" type="button" data-score={score} aria-label={`${score} 星`} aria-pressed="false">
                <span aria-hidden="true"></span>
              </button>
            ))}
          </div>
          <p id="rating-feedback" class="rating-feedback" role="status" aria-live="polite"></p>
        </div>

        {item.tags.length > 0 && (
          <div class="detail-tags">
            <p>这颗的标签</p>
            <ul>{item.tags.map((tag) => <li><a href={`/search?q=${encodeURIComponent(tag)}`}>#{tag}</a></li>)}</ul>
          </div>
        )}
      </aside>
    </div>

    {relatedItems.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">同一串上</p>
            <h2 id="related-title">也许你还会喜欢</h2>
          </div>
          <a href={`/category/${item.category}`} class="text-link">逛完{cat.label} <span aria-hidden="true">→</span></a>
        </div>
        <div class="collection-grid related-grid">
          {relatedItems.map((related, index) => (
            <ItemCard
              title={related.title}
              category={related.category}
              tags={related.tags}
              summary={related.summary}
              cover={related.cover}
              slug={related.id}
              country={related.country}
              mood={related.mood}
              index={index + 1}
            />
          ))}
        </div>
      </section>
    )}

    <div id="item-runtime-data" data-item-id={item.id} data-item-title={item.title} hidden></div>
    <script>
      import { readStored, writeStored } from '../../lib/dom';
      const runtimeData = document.getElementById('item-runtime-data');
      const itemId = runtimeData?.dataset.itemId || '';
      const itemTitle = runtimeData?.dataset.itemTitle || '';
      const STORAGE_KEY = `rated:${itemId}`;
      const ratingButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.rating-fruit'));
      const feedback = document.getElementById('rating-feedback');

      function formatCount(value: number) {
        const count = Number(value) || 0;
        return count >= 1000 ? `${(count / 1000).toFixed(1)}k` : String(count);
      }

      async function initViews() {
        const response = await fetch(`/api/views/${itemId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: '{}',
        }).catch(() => null);
        if (!response?.ok) return;
        const { count } = await response.json();
        const element = document.getElementById('view-count');
        if (element) element.textContent = formatCount(count);
      }

      async function initRatings() {
        const response = await fetch(`/api/ratings/${itemId}`).catch(() => null);
        if (!response?.ok) return;
        const { average, count } = await response.json();
        const averageElement = document.getElementById('community-avg');
        const countElement = document.getElementById('community-count');
        if (averageElement) averageElement.textContent = average ? average.toFixed(1) : '暂无';
        if (countElement) countElement.textContent = String(count || 0);
      }

      function paintRating(score: number) {
        ratingButtons.forEach((button) => {
          const active = Number(button.dataset.score) <= score;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(Number(button.dataset.score) === score));
        });
      }

      function initRatingInput() {
        const saved = Number(readStored(STORAGE_KEY) || 0);
        if (saved) {
          paintRating(saved);
          if (feedback) feedback.textContent = '你已经评过了，可以重新选择。';
        }

        ratingButtons.forEach((button) => {
          button.addEventListener('pointerenter', () => paintRating(Number(button.dataset.score)));
          button.addEventListener('focus', () => paintRating(Number(button.dataset.score)));
          button.addEventListener('pointerleave', () => paintRating(Number(readStored(STORAGE_KEY) || 0)));
          button.addEventListener('blur', () => paintRating(Number(readStored(STORAGE_KEY) || 0)));
          button.addEventListener('click', async () => {
            const score = Number(button.dataset.score);
            ratingButtons.forEach((entry) => { entry.disabled = true; });
            paintRating(score);
            if (feedback) feedback.textContent = '正在把这颗糖挂上去…';

            const response = await fetch(`/api/ratings/${itemId}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ score }),
            }).catch(() => null);

            ratingButtons.forEach((entry) => { entry.disabled = false; });
            if (!response?.ok) {
              paintRating(Number(readStored(STORAGE_KEY) || 0));
              if (feedback) feedback.textContent = '这次没挂上，请稍后再试。';
              return;
            }

            writeStored(STORAGE_KEY, String(score));
            const { average, count } = await response.json();
            const averageElement = document.getElementById('community-avg');
            const countElement = document.getElementById('community-count');
            if (averageElement) averageElement.textContent = average ? average.toFixed(1) : '—';
            if (countElement) countElement.textContent = String(count || 0);
            if (feedback) feedback.textContent = `谢谢你留下 ${score} 颗糖。`;
          });
        });
      }

      document.getElementById('share-button')?.addEventListener('click', async () => {
        const button = document.getElementById('share-button');
        try {
          if (navigator.share) {
            await navigator.share({ title: `${itemTitle} · 糖葫芦`, url: location.href });
          } else {
            await navigator.clipboard.writeText(location.href);
            if (button) button.textContent = '链接已复制 ✓';
          }
        } catch (error) { if (button && !(error instanceof DOMException && error.name === 'AbortError')) button.textContent = '复制失败，请复制地址栏链接'; }
      });

      if (itemId) {
        initViews();
        initRatings();
        initRatingInput();
      }
    </script>
  </BaseLayout>
) : (
  <BaseLayout title="没有找到" description="这根签上还没有这一颗。">
    <section class="not-found">
      <p class="not-found__code">404</p>
      <div class="not-found__fruit" aria-hidden="true">?</div>
      <p class="section-kicker">这根签上还没有这一颗</p>
      <h1>可能被吃掉了。</h1>
      <p>你要找的内容不存在，或者已经被挪到了别处。</p>
      <div class="not-found__actions">
        <a class="button button--primary" href="/">回到首页</a>
        <a class="button button--secondary" href="/search">去搜索</a>
      </div>
    </section>
  </BaseLayout>
)}
