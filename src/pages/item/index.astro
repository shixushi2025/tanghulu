---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemCard from '../../components/ItemCard.astro';
import CoverImage from '../../components/CoverImage.astro';
import CardTemplate from '../../components/CardTemplate.astro';
import AsyncState from '../../components/AsyncState.astro';
import { categoryConfig } from '../../lib/categories';
import type { Item } from '../../lib/db';
const item: Item = { id: '__ID__', title: '__TITLE__', summary: '__SUMMARY__', country: '__COUNTRY__', date: '__DATE__', category: 'other', cover: '', link: 'https://example.com', mood: ['__MOOD__'], tags: ['__TAG__'], body: '', featured: false };
const cat = categoryConfig.other;
const headings = [{ id: 'section-1', title: '目录' }];
const readingMinutes = 1;
const bodyHtml = '';
const relatedItems: Item[] = [item];
const externalLabel = '打开原页面';
---
<BaseLayout title="内容详情">
  <AsyncState /><CardTemplate />
  <div id="detail-content"></div>
  <template id="detail-template">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">整串</a><span aria-hidden="true">/</span>
      <a href={`/category/${item.category}`}>{cat.label}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{item.title}</span>
    </nav>

    <article class="detail-hero" style={`--category-accent:${cat.accent};--category-tint:${cat.tint}`}>
      <figure class="detail-cover">
      <div class="detail-poster">
        <CoverImage src={item.cover} title={item.title} category={item.category} eager detail>
          <div class="detail-poster__art" aria-hidden="true">
            <span class="detail-poster__label">TANGHULU SELECTS</span>
            <span class="detail-poster__number">{cat.shortLabel}</span>
            <span class="detail-poster__skewer"></span>
            <span class="detail-poster__fruit detail-poster__fruit--one"></span>
            <span class="detail-poster__fruit detail-poster__fruit--two"></span>
            <span class="detail-poster__fruit detail-poster__fruit--three"></span>
            <span class="detail-poster__category">{cat.label}</span>
          </div>
        </CoverImage>
      </div>
      </figure>

      <div class="detail-hero__copy">
        <div class="detail-hero__meta">
          <a class="category-pill" href={`/category/${item.category}`} style={`--pill-accent:${cat.accent};--pill-tint:${cat.tint}`}>{cat.label}</a>
          {item.country && <span>{item.country}</span>}
          <time datetime={item.date}>{item.date}</time>
        </div>
        <p class="section-kicker">一颗认真整理的内容</p>
        <h1>{item.title}</h1>
        <p class="detail-hero__summary"><span>一句话</span>{item.summary}</p>

        {item.mood.length > 0 && (
          <div class="detail-contexts">
            <span>适合</span>
            <ul aria-label="适合场景">
              {item.mood.map((mood) => <li>{mood}</li>)}
            </ul>
          </div>
        )}

        <div class="detail-actions">
          {item.link && (
            <a href={item.link} target="_blank" rel="noopener noreferrer" class="button button--primary">
              {externalLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
          <button id="share-button" class="button button--secondary" type="button">分享这颗 <span aria-hidden="true">↗</span></button>
        </div>

        <div class="detail-stats" aria-label="社区数据">
          <div><strong id="community-avg">—</strong><span>社区评分 / 5</span></div>
          <div><strong id="community-count">—</strong><span>人留下评分</span></div>
          <div><strong id="view-count">—</strong><span>次被摘下</span></div>
        </div>
      </div>
    </article>

    <div class="detail-layout">
      <article class="detail-article prose"><p class="reading-meta">约 {readingMinutes} 分钟阅读 · 供你慢慢挑选</p><Fragment set:html={bodyHtml || '<p>这颗内容的详细介绍正在整理中。</p>'} /></article>

      <aside class="detail-sidebar">
        {headings.length > 0 && <nav class="reading-nav" aria-label="本文目录"><h2>这颗的味道</h2>{headings.map(heading => <a href={`#${heading.id}`}>{heading.title}</a>)}</nav>}
        <div class="rating-panel">
          <p class="section-kicker">轮到你了</p>
          <h2>你会给它几颗糖？</h2>
          <p>你的评分会和其他读者一起，留在这根签上。</p>
          <div class="sugar-rating" id="sugar-rating" role="group" aria-label="选择一到五星评分">
            {[1, 2, 3, 4, 5].map((score) => (
              <button class="rating-fruit" type="button" data-score={score} aria-label={`${score} 星`} aria-pressed="false">
                <span aria-hidden="true"></span>
              </button>
            ))}
          </div>
          <p id="rating-feedback" class="rating-feedback" role="status" aria-live="polite"></p>
        </div>

        {item.tags.length > 0 && (
          <div class="detail-tags">
            <p>这颗的标签</p>
            <ul>{item.tags.map((tag) => <li><a href={`/search?q=${encodeURIComponent(tag)}`}>#{tag}</a></li>)}</ul>
          </div>
        )}
      </aside>
    </div>

    {relatedItems.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker">同一串上</p>
            <h2 id="related-title">也许你还会喜欢</h2>
          </div>
          <a href={`/category/${item.category}`} class="text-link">逛完{cat.label} <span aria-hidden="true">→</span></a>
        </div>
        <div class="collection-grid related-grid">
          {relatedItems.map((related, index) => (
            <ItemCard
              title={related.title}
              category={related.category}
              tags={related.tags}
              summary={related.summary}
              cover={related.cover}
              slug={related.id}
              country={related.country}
              mood={related.mood}
              index={index + 1}
            />
          ))}
        </div>
      </section>
    )}

    <div id="item-runtime-data" data-item-id={item.id} data-item-title={item.title} hidden></div>

  </template>
  <script>import '../../scripts/detail-page';</script>
</BaseLayout>
