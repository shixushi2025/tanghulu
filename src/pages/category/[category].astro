---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allCategories, categoryConfig } from '../../lib/categories';
import CardTemplate from '../../components/CardTemplate.astro';
import AsyncState from '../../components/AsyncState.astro';
export function getStaticPaths() { return allCategories.map(category => ({ params: { category } })); }
const category = Astro.params.category!;
const cat = categoryConfig[category];
---
<BaseLayout title={cat.label} description={`${cat.description}。糖葫芦的${cat.label}私人精选。`}>
  <header class="category-hero" style={`--category-accent:${cat.accent};--category-tint:${cat.tint}`}>
    <div class="category-hero__copy">
      <a href="/" class="breadcrumb-link">← 回到整串</a>
      <p class="section-kicker">CATEGORY / {category.toUpperCase()}</p><h1>{cat.label}</h1><p>{cat.description}。</p>
      <div class="category-hero__count"><strong data-collection-total>—</strong><span>颗精选<br />仍在继续收集</span></div>
    </div><div class="category-hero__fruit" aria-hidden="true"><span>{cat.shortLabel}</span><small>{cat.label}</small></div>
  </header>
  <nav id="collection" class="category-rail category-rail--page" aria-label="切换分类">
    <a class="category-filter" href="/">全部</a>
    {allCategories.map(key => <a class:list={['category-filter', { 'is-active': key === category }]} href={`/category/${key}`} aria-current={key === category ? 'page' : undefined}>{categoryConfig[key].label}</a>)}
  </nav>
  <AsyncState /><CardTemplate />
  <div id="collection-empty" class="empty-state" hidden><h2>这一串还空着</h2><p>等遇到真正值得的内容，再认真挂上来。</p></div>
  <div class="collection-grid category-grid"></div>
  <nav class="pagination" aria-label="内容分页"></nav>
  <script>import '../../scripts/browse-page';</script>
</BaseLayout>
