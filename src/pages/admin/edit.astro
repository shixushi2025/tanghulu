---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ItemForm from '../../components/ItemForm.astro';
---
<AdminLayout title="编辑内容" editor>
  <a slot="actions" id="published-preview" href="/" target="_blank" rel="noopener noreferrer" hidden>查看已发布内容 ↗</a>
  <section class="admin-heading"><div><p class="section-kicker">REFINE THE COLLECTION</p><h1>让这一颗，更完整。</h1><p id="editing-title">加载后可编辑内容，保存即对读者生效。</p></div></section>
  <p id="load-status" class="admin-status" role="status">正在加载内容…</p><button id="load-retry" class="button button--secondary" hidden>重新加载</button>
  <ItemForm editing />
</AdminLayout>
