---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { allCategories, categoryConfig } from '../../lib/categories';
---
<AdminLayout title="内容工作台">
  <button slot="actions" id="logout-btn" type="button">退出</button>
  <section class="admin-heading"><div><p class="section-kicker">CONTENT STUDIO</p><h1>把每一颗，整理好。</h1><p>浏览内容、补齐封面，再把值得的放到首页。</p></div><a class="button button--primary" href="/admin/items/new"><Icon name="plus" />新增内容</a></section>
  <p id="load-status" class="admin-status" role="status">正在加载内容…</p><button id="load-retry" class="button button--secondary" hidden>重新加载</button>
  <noscript><p>管理内容需要 JavaScript，请启用后重试。</p></noscript>
  <section class="admin-metrics" aria-label="内容概况">
    <a href="/admin/dashboard"><Icon name="grid" /><span>全部内容</span><strong data-metric="total">—</strong><small>查看完整内容库 →</small></a>
    <a href="/admin/dashboard?featured=1"><Icon name="star" /><span>标记为精选</span><strong data-metric="featured">—</strong><small>首页最多展示 6 条 →</small></a>
    <a href="/admin/dashboard?coverage=present"><Icon name="image" /><span>已配封面</span><strong data-metric="withCover">—</strong><small>检查图片与 Logo →</small></a>
    <a href="/admin/dashboard?coverage=missing"><Icon name="image" /><span>待补封面</span><strong data-metric="missing">—</strong><small>打开待整理清单 →</small></a>
  </section>
  <section class="admin-overview" aria-labelledby="overview-title">
    <div><p class="section-kicker">LIBRARY AT A GLANCE</p><h2 id="overview-title"><Icon name="chart" />内容分布</h2><p>按当前内容数量统计。点选分类，继续整理。</p><p id="coverage-summary" role="status"></p><progress id="coverage-progress" max="100" value="0" aria-label="封面地址覆盖率"></progress><small>统计已填写的封面地址，不代表图片实时可用性。</small></div>
    <ul id="category-chart" class="admin-chart" aria-label="各分类内容数量">
      {allCategories.map(key => <li><a href={`/admin/dashboard?cat=${key}`} style={`--bar-color:${categoryConfig[key].accent}`}><span>{categoryConfig[key].label}</span><span class="admin-chart__track" aria-hidden="true"><i data-bar={key}></i></span><strong data-admin-count={key}>—</strong></a></li>)}
    </ul>
  </section>
  <section class="admin-library" aria-labelledby="library-title">
    <div class="admin-library__heading"><h2 id="library-title">内容库</h2><span id="result-count" role="status"></span></div>
    <form action="/admin/dashboard" method="get" class="admin-filters">
      <label class="admin-filter-query">搜索内容<input type="search" name="q" maxlength="100" placeholder="标题、ID 或摘要" /></label>
      <label>分类<select aria-label="分类" name="cat"><option value="">全部分类</option>{allCategories.map(key => <option value={key}>{categoryConfig[key].label}</option>)}</select></label>
      <label>封面<select aria-label="封面" name="coverage"><option value="">全部封面</option><option value="missing">待补封面</option><option value="present">已配封面</option></select></label>
      <label>精选<select aria-label="精选" name="featured"><option value="">全部内容</option><option value="1">已标记精选</option><option value="0">未标记精选</option></select></label>
      <label>排序<select aria-label="排序" name="sort"><option value="newest">最新收录</option><option value="oldest">最早收录</option><option value="title">标题排序</option></select></label>
      <button class="button button--primary" type="submit">筛选</button><a class="admin-reset" href="/admin/dashboard">清空</a>
    </form>
    <div class="admin-table-wrap"><table class="admin-table"><caption class="sr-only">内容条目与编辑操作</caption><thead><tr><th scope="col">内容</th><th scope="col">分类 / 状态</th><th scope="col" class="admin-date">收录日期</th><th scope="col">操作</th></tr></thead><tbody></tbody></table></div>
    <nav id="admin-pagination" class="pagination" aria-label="内容分页"></nav>
  </section>
  <dialog id="modal" aria-labelledby="modal-heading"><h2 id="modal-heading">确认删除</h2><p>删除「<span id="modal-title"></span>」及其评分、浏览数据？此操作不可撤销。</p><p id="delete-error" role="alert" hidden></p><div class="admin-dialog-actions"><button id="modal-cancel" class="button button--secondary" autofocus>取消</button><button id="modal-confirm" class="button button--primary">确认删除</button></div></dialog>
  <script>import '../../scripts/dashboard';</script>
</AdminLayout>
