---
import '../../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Admin · 糖葫芦</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: var(--sans); background: var(--paper); color: #1c1917; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; }
      .card { background: #fff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 2rem; width: 100%; max-width: 360px; }
      .logo { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1.125rem; margin-bottom: 1.5rem; }
      .logo img { width: 24px; height: 24px; }
      label { display: block; font-size: 0.875rem; font-weight: 500; color: #57534e; margin-bottom: 4px; }
      input[type=password] { width: 100%; padding: 0.625rem 0.75rem; border: 1px solid #d6d3d1; border-radius: 8px; font-size: 0.9375rem; outline: none; transition: border-color 0.15s; }
      input[type=password]:focus { border-color: #1c1917; }
      button { width: 100%; margin-top: 1rem; padding: 0.625rem; background: var(--red); color: #fff; border: none; border-radius: 8px; font-size: 0.9375rem; font-weight: 500; cursor: pointer; transition: opacity 0.15s; }
      button:hover { opacity: 0.85; }
      button:disabled { opacity: 0.5; cursor: not-allowed; }
      .error { margin-top: 0.75rem; font-size: 0.8125rem; color: #dc2626; }
    </style>
  </head>
  <body>
    <main class="card"><form id="login-form">
      <a href="/" class="logo">
        <img src="/favicon.svg" alt="" />
        <span>糖葫芦 · 内容工作台</span>
      </a>
      <h1 style="font-size:1.4rem;margin-bottom:1rem">登录内容工作台</h1>
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem">把下一颗值得的，认真串进来。</p>
      <label for="pwd">密码</label>
      <input id="pwd" type="password" required maxlength="1024" placeholder="输入管理密码" autocomplete="current-password" />
      <button id="btn" type="submit">登录</button>
      <p id="err" class="error" role="alert" hidden></p>
      <noscript><p class="error">请启用 JavaScript 后登录工作台。</p></noscript>
    </form></main>
    <script>
      import { requiredElement } from '../../lib/dom';
      import { adminDestination } from '../../lib/admin-navigation';
      const input = requiredElement('#pwd', HTMLInputElement);
      const btn = requiredElement('#btn', HTMLButtonElement);
      const err = requiredElement('#err', HTMLElement);

      async function login() {
        const password = input.value;
        if (!password || btn.disabled) return;
        btn.disabled = true;
        err.hidden = true;
        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password }),
          });
          if (res.ok) {
            location.href = adminDestination(new URLSearchParams(location.search).get('next'));
          } else {
            const data = await res.json();
            err.textContent = data.error ?? '登录失败';
            err.hidden = false;
          }
        } catch {
          err.textContent = '网络错误';
          err.hidden = false;
        }
        btn.disabled = false;
      }

      requiredElement('#login-form', HTMLFormElement).addEventListener('submit', event => { event.preventDefault(); void login(); });
      input.focus();
    </script>
  </body>
</html>
