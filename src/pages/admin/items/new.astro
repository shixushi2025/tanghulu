---
import { allCategories, categoryConfig } from '../../../lib/categories';
import '../../../styles/global.css';

const today = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>新增内容 · Admin</title>
  </head>
  <body class="admin-shell bg-stone-50 text-stone-900 antialiased min-h-screen">
    <header class="sticky top-0 z-50 bg-white border-b border-stone-200">
      <div class="max-w-4xl mx-auto px-4 h-14 flex items-center gap-3">
        <a href="/admin/dashboard" class="text-stone-400 hover:text-stone-700 transition-colors text-sm">← 返回</a>
        <span class="text-stone-300">/</span>
        <span class="font-semibold text-sm">新增内容</span>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <form id="item-form" class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left: main fields -->
        <div class="lg:col-span-2 space-y-5">
          <div class="bg-white border border-stone-200 rounded-xl p-5 space-y-4">
            <div>
              <label for="f-title" class="block text-sm font-medium text-stone-700 mb-1.5">标题 <span class="text-red-500">*</span></label>
              <input id="f-title" maxlength="160" type="text" required class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" placeholder="内容标题" />
            </div>
            <div>
              <label for="f-summary" class="block text-sm font-medium text-stone-700 mb-1.5">摘要 <span class="text-red-500">*</span></label>
              <textarea id="f-summary" maxlength="600" rows="3" required class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors resize-none" placeholder="一两句话介绍这个内容"></textarea>
            </div>
            <div>
              <label for="f-body" class="block text-sm font-medium text-stone-700 mb-1.5">正文（Markdown）</label>
              <textarea id="f-body" maxlength="50000" rows="10" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors resize-y font-mono" placeholder="## 小标题&#10;&#10;正文内容…"></textarea>
            </div>
          </div>
        </div>

        <!-- Right: metadata -->
        <div class="space-y-5">
          <div class="bg-white border border-stone-200 rounded-xl p-5 space-y-4">
            <div>
              <label for="f-id" class="block text-sm font-medium text-stone-700 mb-1.5">ID（slug）<span class="text-red-500">*</span></label>
              <input id="f-id" maxlength="100" type="text" required pattern="[a-zA-Z0-9_-]+" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm font-mono focus:outline-none focus:border-stone-500 transition-colors" placeholder="my-item-slug" />
              <p class="text-xs text-stone-400 mt-1">字母、数字、- 和 _，创建后不可修改</p>
            </div>
            <div>
              <label for="f-category" class="block text-sm font-medium text-stone-700 mb-1.5">分类 <span class="text-red-500">*</span></label>
              <select id="f-category" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors bg-white">
                {allCategories.map(key => (
                  <option value={key}>{categoryConfig[key]?.label ?? key}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="f-date" class="block text-sm font-medium text-stone-700 mb-1.5">日期 <span class="text-red-500">*</span></label>
              <input id="f-date" type="date" value={today} required class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" />
            </div>
            <div>
              <label for="f-country" class="block text-sm font-medium text-stone-700 mb-1.5">国家/地区</label>
              <input id="f-country" maxlength="80" type="text" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" placeholder="美国、中国…" />
            </div>
            <div>
              <label for="f-tags" class="block text-sm font-medium text-stone-700 mb-1.5">标签</label>
              <input id="f-tags" type="text" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" placeholder="逗号分隔，如：AI, 效率" />
            </div>
            <div>
              <label for="f-mood" class="block text-sm font-medium text-stone-700 mb-1.5">适合场景</label>
              <input id="f-mood" type="text" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" placeholder="逗号分隔，如：通勤, 深夜" />
            </div>
            <div>
              <label for="f-cover" class="block text-sm font-medium text-stone-700 mb-1.5">封面图地址</label>
              <input id="f-cover" maxlength="2048" type="text" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" placeholder="https://…" />
            </div>
            <div>
              <label for="f-link" class="block text-sm font-medium text-stone-700 mb-1.5">链接</label>
              <input id="f-link" maxlength="2048" type="url" class="w-full px-3 py-2 border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-stone-500 transition-colors" placeholder="https://…" />
            </div>
          </div>

          <div class="flex gap-3">
            <a href="/admin/dashboard" class="flex-1 px-4 py-2.5 text-sm text-center border border-stone-200 rounded-lg hover:bg-stone-50 transition-colors">取消</a>
            <button type="submit" id="submit-btn" class="flex-1 px-4 py-2.5 text-sm bg-stone-900 text-white rounded-lg hover:opacity-90 transition-opacity font-medium">创建</button>
          </div>
          <p id="form-error" role="alert" tabindex="-1" class="text-sm text-red-500 hidden"></p>
        </div>
      </form>
    </main>

    <script>import '../../../scripts/item-form';</script>
  </body>
</html>
